{
  "name": "ai-studio",
  "version": "0.1.0",
  "description": "Open-source AI video studio. Describe a shot list, and it orchestrates image, video, voice and sound models, then edits everything into a finished MP4.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JonTelep/ai-studio"
  },
  "scripts": {
    "studio": "tsx src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@fontsource/anton": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.532",
    "tsx": "^4.20.5",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
