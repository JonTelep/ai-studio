# Copy to .env and fill in only the providers you use.
# Never commit .env. The placeholder provider needs no keys and makes no network calls.

# fal.ai key for image and video generation.
# https://fal.ai/dashboard/keys
FAL_KEY=

# Optional ElevenLabs key for text-to-speech with word timestamps.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Set to 1 to refuse every paid provider call. CI sets this.
# STUDIO_FORBID_PAID=1
